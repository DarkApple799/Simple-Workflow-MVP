# wfa 环境变量模板
# 复制为 .env 后填入自己的 Key（获取地址 https://platform.deepseek.com/api_keys）
# 说明：.env 已在 .gitignore 中，不会被提交；报告与日志里也绝不包含密钥。

# ---- 模型服务（任何 OpenAI 兼容接口都可以）----
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 运行模式 ----
# offline：不联网，使用确定性规则引擎 + 模板模型（默认，演示用）
# online ：调用真实 LLM
WFA_MODE=offline

# ---- 编排限额 ----
WFA_MAX_TURNS=50
WFA_MAX_ITERATIONS=3
WFA_PARALLEL_WORKERS=3
WFA_REVIEW_MAX_STEPS=4
WFA_STOP_ON_BLOCKING=true
WFA_WRITE_WORKSPACE=true

# ---- 模型参数 ----
WFA_TEMPERATURE=0.2
WFA_TIMEOUT=60
WFA_MAX_RETRIES=3
WFA_MAX_TOKENS=4096
# 传输层：http（标准库）| sdk（需要 pip install openai）
WFA_TRANSPORT=http

# ---- 工作区扫描限额 ----
WFA_MAX_FILES=200
WFA_MAX_FILE_BYTES=200000

# ---- 输出 ----
WFA_VERBOSE=false
WFA_COLOR=true

# ---- 复用 Homework1 的代码审查 Agent（可选）----
# 指向 Homework1 工程目录（内含 cra 包）。设置后 code_review 流程里的
# `legacy_review` 节点会调用 Homework1 的 CodeReviewAgent（扫描器 + 25 条 AST 规则 + 工具循环），
# 把它的 findings 汇入 review 节点；适配器可用时报告指标里会出现 legacy: True。
# 也可用别名 WFA_CRA_ROOT / CRA_ROOT / HW1_ROOT（优先级：WFA_LEGACY_CRA_ROOT > WFA_CRA_ROOT > ...）
WFA_LEGACY_CRA_ROOT=
